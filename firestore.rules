rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if 'reviewDate' in request.resource.data;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
