rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Access control
    //
    // Signing in with Google is not enough on its own -- anyone with any
    // Google account could do that. A caller must ALSO be on the allowlist.
    //
    // The allowlist lives in Firestore at `config/allowlist` rather than in
    // this file, for two reasons: the addresses stay out of the public repo,
    // and people can be added or removed in the Firebase console without
    // redeploying rules.
    //
    // Expected shape of `config/allowlist`:
    //   {
    //     emails:  ["jesus.calo0830@gmail.com", "jt@vibe-collective.cc"],
    //     domains: ["vibe-collective.cc"]
    //   }
    //
    // Either list may be omitted. `domains` admits every verified Google
    // account on that domain, which is the easier way to onboard a team.
    // ------------------------------------------------------------------

    function allowlist() {
      return get(/databases/$(database)/documents/config/allowlist).data;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function emailAllowed() {
      // `emails` is optional: treat a missing field as an empty list rather
      // than erroring, so a domains-only allowlist still works.
      return callerEmail() in allowlist().get('emails', []);
    }

    function domainAllowed() {
      return callerEmail().split('@')[1] in allowlist().get('domains', []);
    }

    function isAllowed() {
      // email_verified matters: without it, an unverified account claiming
      // an allowlisted address would pass.
      return request.auth != null
             && request.auth.token.email != null
             && request.auth.token.email_verified == true
             && (emailAllowed() || domainAllowed());
    }

    // ------------------------------------------------------------------
    // The allowlist itself.
    //
    // Readable by any signed-in user, because the rules engine reads it on
    // their behalf when evaluating isAllowed(). Not writable from the client
    // at all -- edit it in the Firebase console. If it were writable, an
    // allowlisted user could add anyone, and a bug could lock everyone out.
    // ------------------------------------------------------------------
    match /config/allowlist {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // One shared workspace per team: everyone allowlisted sees the same data,
    // which is the point -- a colleague's upload has to show up for everyone.
    //
    // This is a trust boundary at the account level, not the row level.
    // Anyone on the allowlist can edit every review.
    // ------------------------------------------------------------------
    match /workspaces/{workspaceId}/reviews/{reviewId} {
      allow read: if isAllowed();

      // Create and update only -- deletion is denied for everyone.
      //
      // `write` would have included delete. Reviews are append-only on
      // purpose: the workspace is shared, so one clear would destroy the
      // dataset for the whole team, and re-uploading every source file is
      // the only way back. Enforcing it here rather than only in the UI
      // means a console or script cannot delete either.
      //
      // Removing rows now requires an explicit rules change, or the
      // Firebase console with owner credentials.
      allow create, update: if isAllowed();
      allow delete: if false;
    }

    // Legacy per-user path, kept readable during migration so anything
    // written before the switch is still reachable. Safe to delete once
    // the shared workspace is populated.
    match /users/{userId}/reviews/{reviewId} {
      allow read: if isAllowed() && request.auth.uid == userId;
      allow create, update: if isAllowed() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Everything else, including the old world-readable top-level `reviews`
    // collection, is closed. Delete that collection in the Firebase console
    // once the shared workspace is populated.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
